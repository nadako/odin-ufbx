inputs = ["../upstream/ufbx.h"]
output_folder = "../ufbx"
package_name = "ufbx"
import_lib = "ufbx.lib"
remove_function_prefix = "ufbx_"
remove_type_prefix = "ufbx_"
remove_macro_prefix = "UFBX_"
clang_defines = {
    "UFBX_REAL_IS_FLOAT" = "1",

    // make ufbx_inline a noop so bindgen can pickup inlined procs
    //"UFBX_PLATFORM_MSC" = "0",
    //"UFBX_PLATFORM_GNUC" = "0",
}
procedures_at_end = true
rename = {
    "ufbx_matrix" = "Mat43"
}
type_overrides = {
    "ufbx_string" = "string"
    "ufbx_blob" = "[]byte"
    "ufbx_vec2" = "[2]f32"
    "ufbx_vec3" = "[3]f32"
    "ufbx_vec4" = "[4]f32"
    "ufbx_quat" = "quaternion128",
    "ufbx_matrix" = "#row_major matrix[4,3]f32",
    "ufbx_node_list" = "[]^Node",
    "ufbx_void_list" = "[]rawptr",
    "ufbx_bool_list" = "[]bool",
    "ufbx_uint32_list" = "[]u32",
    "ufbx_int32_list" = "[]i32",
    "ufbx_int64_list" = "[]i64",
    "ufbx_float_list" = "[]f32",
    "ufbx_double_list" = "[]f64",
    "ufbx_blob_list" = "[]Blob",
    "ufbx_real_list" = "[]f32",
    "ufbx_vec2_list" = "[]Vec2",
    "ufbx_vec3_list" = "[]Vec3",
    "ufbx_vec4_list" = "[]Vec4",
    "ufbx_string_list" = "[]String",
    "ufbx_dom_node_list" = "[]^Dom_Node",
    "ufbx_dom_value_list" = "[]Dom_Value",
    "ufbx_prop_list" = "[]Prop",
    "ufbx_element_list" = "[]^Element",
    "ufbx_unknown_list" = "[]^Unknown",
    "ufbx_mesh_list" = "[]^Mesh",
    "ufbx_light_list" = "[]^Light",
    "ufbx_camera_list" = "[]^Camera",
    "ufbx_bone_list" = "[]^Bone",
    "ufbx_empty_list" = "[]^Empty",
    "ufbx_line_curve_list" = "[]^Line_Curve",
    "ufbx_nurbs_curve_list" = "[]^Nurbs_Curve",
    "ufbx_nurbs_surface_list" = "[]^Nurbs_Surface",
    "ufbx_nurbs_trim_surface_list" = "[]^Nurbs_Trim_Surface",
    "ufbx_nurbs_trim_boundary_list" = "[]^Nurbs_Trim_Boundary",
    "ufbx_face_list" = "[]Face",
    "ufbx_mesh_part_list" = "[]Mesh_Part",
    "ufbx_face_group_list" = "[]Face_Group",
    "ufbx_material_list" = "[]^Material",
    "ufbx_material_texture_list" = "[]Material_Texture",
    "ufbx_texture_list" = "[]^Texture",
    "ufbx_texture_file_list" = "[]Texture_File",
    "ufbx_shader_list" = "[]^Shader",
    "ufbx_shader_binding_list" = "[]^Shader_Binding",
    "ufbx_procedural_geometry_list" = "[]^Procedural_Geometry",
    "ufbx_stereo_camera_list" = "[]^Stereo_Camera",
    "ufbx_camera_switcher_list" = "[]^Camera_Switcher",
    "ufbx_marker_list" = "[]^Marker",
    "ufbx_lod_group_list" = "[]^Lod_Group",
    "ufbx_skin_deformer_list" = "[]^Skin_Deformer",
    "ufbx_skin_cluster_list" = "[]^Skin_Cluster",
    "ufbx_blend_deformer_list" = "[]^Blend_Deformer",
    "ufbx_blend_channel_list" = "[]^Blend_Channel",
    "ufbx_blend_shape_list" = "[]^Blend_Shape",
    "ufbx_cache_deformer_list" = "[]^Cache_Deformer",
    "ufbx_cache_file_list" = "[]^Cache_File",
    "ufbx_video_list" = "[]^Video",
    "ufbx_anim_stack_list" = "[]^Anim_Stack",
    "ufbx_anim_layer_list" = "[]^Anim_Layer",
    "ufbx_anim_value_list" = "[]^Anim_Value",
    "ufbx_anim_curve_list" = "[]^Anim_Curve",
    "ufbx_display_layer_list" = "[]^Display_Layer",
    "ufbx_selection_set_list" = "[]^Selection_Set",
    "ufbx_selection_node_list" = "[]^Selection_Node",
    "ufbx_character_list" = "[]^Character",
    "ufbx_constraint_list" = "[]^Constraint",
    "ufbx_audio_layer_list" = "[]^Audio_Layer",
    "ufbx_audio_clip_list" = "[]^Audio_Clip",
    "ufbx_pose_list" = "[]^Pose",
    "ufbx_metadata_object_list" = "[]^Metadata_Object",
    "ufbx_connection_list" = "[]Connection",
    "ufbx_uv_set_list" = "[]Uv_Set",
    "ufbx_color_set_list" = "[]Color_Set",
    "ufbx_edge_list" = "[]Edge",
    "ufbx_subdivision_weight_range_list" = "[]Subdivision_Weight_Range",
    "ufbx_subdivision_weight_list" = "[]Subdivision_Weight",
    "ufbx_line_segment_list" = "[]Line_Segment",
    "ufbx_lod_level_list" = "[]Lod_Level",
    "ufbx_skin_vertex_list" = "[]Skin_Vertex",
    "ufbx_skin_weight_list" = "[]Skin_Weight",
    "ufbx_blend_keyframe_list" = "[]Blend_Keyframe",
    "ufbx_cache_frame_list" = "[]Cache_Frame",
    "ufbx_cache_channel_list" = "[]Cache_Channel",
    "ufbx_texture_layer_list" = "[]Texture_Layer",
    "ufbx_shader_texture_input_list" = "[]Shader_Texture_Input",
    "ufbx_shader_prop_binding_list" = "[]Shader_Prop_Binding",
    "ufbx_prop_override_list" = "[]Prop_Override",
    "ufbx_transform_override_list" = "[]Transform_Override",
    "ufbx_anim_prop_list" = "[]Anim_Prop",
    "ufbx_keyframe_list" = "[]Keyframe",
    "ufbx_constraint_target_list" = "[]Constraint_Target",
    "ufbx_bone_pose_list" = "[]Bone_Pose",
    "ufbx_name_element_list" = "[]Name_Element",
    "ufbx_warning_list" = "[]Warning",
    "ufbx_baked_vec3_list" = "[]Baked_Vec3",
    "ufbx_baked_quat_list" = "[]Baked_Quat",
    "ufbx_baked_node_list" = "[]Baked_Node",
    "ufbx_baked_prop_list" = "[]Baked_Prop",
    "ufbx_baked_element_list" = "[]Baked_Element",
    "ufbx_const_uint32_list" = "[]u32",
    "ufbx_const_real_list" = "[]f32",
    "ufbx_const_prop_override_desc_list" = "[]Prop_Override_Desc",
    "ufbx_const_transform_override_list" = "[]Transform_Override",
}
bit_setify = {
    "ufbx_prop_flags" = "Prop_Flag"
    "ufbx_topo_flags" = "Topo_Flag"
    "ufbx_baked_key_flags" = "Baked_Key_Flag"
    "ufbx_evaluate_flags" = "Evaluate_Flag"
    "ufbx_transform_flags" = "Transform_Flag"
}
struct_field_overrides = {
    "ufbx_evaluate_opts.evaluate_flags" = "Evaluate_Flags"
    "ufbx_bake_opts.evaluate_flags" = "Evaluate_Flags"
}
procedure_type_overrides = {
    "ufbx_evaluate_transform_flags.flags" = "Transform_Flags"
    "ufbx_generate_indices.streams" = "[^]"
}
remove_enum_members = [
    "*FORCE_32BIT"
]
remove = [

]
force_ada_case_types = true // otherwise there are stupid naming conflicts